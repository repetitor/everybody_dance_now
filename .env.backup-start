APP_NAME="Laravel 12"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=base64:t/gCgNrc9G+Fr7E8Kxt+vKJ5ZBfSy/kVJh48APqIjZY=

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
