XDEBUG_IDE_KEY=PHPSTORM  # PHPSTORM или VSCODE
XDEBUG_PORT=9003

# ======================
# Optional MySQL Config
# ======================
MYSQL_CONFIG_FILE="./docker/mysql/8.0/my.cnf"
MYSQL_ROOT_PASSWORD="${DB_PASSWORD}"